# =============================================================================
# SERALI JEV WORKFORCE LAB — Environment Configuration
# =============================================================================
# Copy this file to backend/.env and fill in your API keys.
# NEVER commit .env files with real keys.
# =============================================================================

# --- TypeSafe / Jev ---
TYPESAFE_API_KEY=your_typesafe_api_key_here
JEV_MODEL=jev-1.13.0
# Current documented Jev 1.13 input price (USD per million tokens)
JEV_INPUT_PRICE_PER_MILLION=0.042

# --- LLM Baseline ---
# Provider: groq, openai, together, or any OpenAI-compatible provider
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_api_key_here
# Base URL override (leave empty to use provider default)
LLM_BASE_URL=https://api.groq.com/openai/v1

# --- LLM Pricing (configurable, do not hardcode) ---
# USD per million tokens — set to match your provider/model
LLM_INPUT_PRICE_PER_MILLION=0.59
LLM_OUTPUT_PRICE_PER_MILLION=0.79

# --- Application ---
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
